MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/szilvia-ingatlan?retryWrites=true&w=majority
PORT=5000

# Set to "production" to enable the production hardening checks (required env
# vars, serving the static build, trust proxy, and so on).
NODE_ENV=development

# Admin login (the /admin page). The password is stored as a bcrypt hash, not
# as plain text. Generate the hash with: npm run hash-password -- <your-password>
ADMIN_PASSWORD_HASH=
JWT_SECRET=pick-a-long-random-secret-key

# Vercel Blob - storage for the property photos (required). Write it out with
# `vercel env pull .env` after attaching Blob storage to the project, or copy
# it from the Storage tab of the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# ntfy.sh - push notifications about new contact messages and appointment
# bookings. Pick a unique, hard-to-guess topic name (e.g. your-company-name-
# <random>), then subscribe to it in the ntfy app (iOS/Android) or at
# https://ntfy.sh/<topic-name>. If the value is empty, the notification is
# simply skipped.
NTFY_TOPIC=

# The production domain of the frontend, if it runs on separate hosting from
# the backend (e.g. https://szilagyiszilvia.hu). If the value is empty, CORS
# allows every origin.
CLIENT_ORIGIN=

# Google Calendar synchronization (optional) - if empty, the appointment
# booking system works without the Google integration, using only its own
# database. Setup: see the "Google Calendar synchronization" section of the
# README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://szilva-ingatlan-web.vercel.app/api/google/callback
