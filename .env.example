MONGODB_URI=mongodb+srv://<felhasznalonev>:<jelszo>@<cluster-url>/szilvia-ingatlan?retryWrites=true&w=majority
PORT=5000

# "production" ertekre allitva production kemenysegi ellenorzesek lepnek
# eletbe (kotelezo env valtozok, static build kiszolgalasa, trust proxy stb.)
NODE_ENV=development

# Admin bejelentkezes (/admin oldal)
ADMIN_PASSWORD=valassz-egy-eros-jelszot
JWT_SECRET=valassz-egy-hosszu-veletlenszeru-titkos-kulcsot

# Vercel Blob - ingatlanfotok tarolasa (kotelezo). Ird ki: `vercel env pull .env`
# miutan a projekthez Blob storage-ot csatoltal, vagy masold a Vercel dashboard
# Storage fuleerol.
BLOB_READ_WRITE_TOKEN=

# ntfy.sh - push ertesites uj kapcsolatfelveteli uzenetekrol es
# idopontfoglalasokrol. Valassz egy egyedi, nehezen kitalalhato temanevet
# (pl. ceged-neve-<veletlen>), majd iratkozz fel ra az ntfy alkalmazasban
# (iOS/Android) vagy a https://ntfy.sh/<temanev> oldalon. Ures ertek eseten
# az ertesites egyszeruen kimarad.
NTFY_TOPIC=

# A frontend eles domain-je, ha kulon hostingon fut, mint a backend
# (pl. https://szilagyiszilvia.hu). Ures ertek eseten a CORS minden origint enged.
CLIENT_ORIGIN=
